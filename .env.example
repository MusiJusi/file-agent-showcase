# Application profile: LangGraph agent + an existing OpenAI-compatible endpoint.
# Copy to .env, then match the URL/model to your server. No model server is started.
# See docs/local_inference.md. Code defaults remain backward-compatible.

# Answering model
LLM_BACKEND=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:18000/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=Qwen/Qwen3.5-27B
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0
# Explicitly disable thinking only if supported by your server's chat template.
# LOCAL_LLM_ENABLE_THINKING=false
# LOCAL_LLM_TIMEOUT_SECONDS=180
# LOCAL_LLM_MAX_RETRIES=0

# Alternative: set LLM_BACKEND=yandex and supply your own credentials.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Agent: code default is standard/4 rounds; this example selects tool_agent/8.
RAG_MODE=tool_agent
RAG_MAX_TOOL_ROUNDS=8
RAG_HISTORY_TURNS=6
# Estimated input tokens; choose a budget below your server's actual context size.
RAG_MAX_CONTEXT_TOKENS=90000

# Structured ingestion
PARSER_PROFILE=structured
CHUNKING_STRATEGY=structured
CHUNK_TARGET_TOKENS=384
TABLE_ROW_RECORDS=true
CHUNK_SEMANTIC_SPLIT=false
# FORMULA_INDEXING=inline

# Local retrieval models: weights are downloaded on first use.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Leave RERANKER_MODEL empty to disable reranking.
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=1024
RERANKER_CANDIDATES=30
RERANKER_BLEND=0
RETRIEVAL_UNIQUE_PASSAGES=true
RETRIEVAL_DIVERSIFY_DOCS=true
BM25_LEMMATIZE=auto
# Optional HyDE expansion adds a model call; the agent can also reformulate searches.
MULTI_QUERY=off
MULTI_QUERY_MODE=hyde
# MULTI_QUERY_COUNT=3
# MULTI_QUERY_WEIGHT=1
# MULTI_QUERY_CACHE=off
QA_PROMPT=v3

# PDF OCR: auto routes image-only pages to VLM with EasyOCR fallback.
# Choices: auto, vlm, easyocr, rapidocr, off. OCR currently supports PDF only.
OCR_ENGINE=auto
OCR_LANGS=ru,en
# OCR_DPI=150

# VLM: llm reuses LOCAL_LLM_BASE_URL / LOCAL_LLM_MODEL.
# Requires a vision-capable endpoint. Use off for text-only operation.
# Other choices: openai (a separate endpoint), smolvlm (local model).
VLM_BACKEND=llm
VLM_MIN_FIGURE_AREA=5000
VLM_MAX_TOKENS=1200
VLM_TIMEOUT_SECONDS=180
VLM_TEMPERATURE=0
VLM_MAX_RETRIES=0
VLM_MAX_VISUAL_PIXELS=1500000
# Unset: page-based figure budget (8..32). A fixed value overrides it.
# VLM_MAX_FIGURES=32
# VLM_OCR_CONCURRENCY=4
# VLM_BASE_URL=http://127.0.0.1:18000/v1
# VLM_MODEL=Qwen/Qwen3.5-27B
# VLM_API_KEY=
# VLM_LOCAL_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct

# PDF formula/code enrichment and degenerate-table repair.
# PDF_ENRICHMENT=on
# PDF_ENRICHMENT_ENGINE=auto
# PDF_ENRICHMENT_CONCURRENCY=8
# PDF_ENRICHMENT_DPI=200
# PDF_ENRICHMENT_CACHE=off
# PDF_ENRICHMENT_BATCH=auto
# PDF_TABLE_VLM=auto

# Observability: optional Jaeger and Langfuse; see docs/deployment.md.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Docker only: override the host endpoint address from inside the container.
# DOCKER_LLM_BASE_URL=http://host.docker.internal:18000/v1
# STREAMLIT_PORT=8501
